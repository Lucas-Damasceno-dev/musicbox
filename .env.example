# MusicBox — variáveis de ambiente
# Copie para .env (cp .env.example .env) e ajuste conforme necessário.

# Porta do servidor HTTP (FastAPI/Uvicorn)
PORT=8080

# Diretório onde as músicas baixadas serão salvas (~ e $HOME são expandidos)
MUSICBOX_DIR=~/Music/musicbox/

# Formato padrão de download: "mp3" ou "opus"
DEFAULT_FORMAT=opus

# Número de workers de download simultâneos
WORKERS=2

# Timeout de socket (segundos) nas requisições de rede
SOCKET_TIMEOUT=30

# Número de tentativas de download antes de considerar falha
RETRIES=2

# Token de acesso compartilhado (opcional): se definido, TODAS as rotas /api/*
# (exceto /api/config) exigem o token — via header `X-MusicBox-Token` ou query
# `?token=` (necessário para <audio>/downloads). O WebSocket /ws exige na query.
# Sem token, a API fica aberta para qualquer dispositivo da rede local.
#MUSICBOX_TOKEN=troque-por-um-token-forte
