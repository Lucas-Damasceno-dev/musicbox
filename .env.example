# MusicBox — variáveis de ambiente
# Copie para .env (cp .env.example .env) e ajuste conforme necessário.

# Porta do servidor HTTP (FastAPI/Uvicorn)
PORT=8080

# Diretório onde as músicas baixadas serão salvas (~ e $HOME são expandidos)
MUSICBOX_DIR=~/Music/musicbox/

# Formato padrão de download: "mp3" ou "opus"
DEFAULT_FORMAT=mp3

# Número de workers de download simultâneos
WORKERS=2

# Timeout de socket (segundos) nas requisições de rede
SOCKET_TIMEOUT=30

# Número de tentativas de download antes de considerar falha
RETRIES=2

# Cookies para o yt-dlp (YouTube bloqueia sem login: "Sign in to confirm you're not a bot")
# COOKIES_FILE — caminho para um arquivo cookies.txt (formato Netscape) exportado de um
# navegador logado no YouTube (ex.: ~/cookies/youtube.txt). Opção recomendada quando
# COOKIES_FROM_BROWSER não funciona.
#COOKIES_FILE=~/cookies/youtube.txt

# COOKIES_FROM_BROWSER — nome do navegador para ler cookies direto: chrome, chromium,
# brave, edge, firefox, safari. Exige o navegador logado no YouTube no mesmo usuário
# do servidor.
#COOKIES_FROM_BROWSER=firefox

# Nota: se ambos forem definidos, COOKIES_FILE tem precedência.
